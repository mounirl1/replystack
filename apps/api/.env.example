# ===========================================
# REPLYSTACK CONFIGURATION
# ===========================================
# This file contains all environment variables for ReplyStack.
# Copy this file to .env and fill in the values.
#
# For PRODUCTION (Railway):
# - APP_ENV=production
# - APP_DEBUG=false
# - APP_URL=https://api.reply-stack.app
# - DATABASE_URL is auto-provided by Railway
# - REDIS_URL is auto-provided by Railway
# ===========================================

APP_NAME=ReplyStack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===========================================
# DATABASE
# ===========================================
# Local development
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=replystack
DB_USERNAME=root
DB_PASSWORD=

# Railway: Use DATABASE_URL instead (auto-generated)
# DATABASE_URL=mysql://user:password@host:port/database

# ===========================================
# SESSION & CACHE
# ===========================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# ===========================================
# REDIS
# ===========================================
# Local development
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Railway: Use REDIS_URL instead (auto-generated)
# REDIS_URL=redis://default:password@host:port

# Horizon
HORIZON_PREFIX=replystack_horizon:

# ===========================================
# MAIL
# ===========================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@replystack.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# MONITORING & ALERTS
# ===========================================
# Slack webhook for system alerts (health checks, errors)
SLACK_ALERTS_WEBHOOK_URL=

# ===========================================
# AI PROVIDERS
# ===========================================
# Gemini (Default - Free for all users)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Mistral (Paid users only - Better for French)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Claude API (Anthropic - Not currently active)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# LemonSqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Google OAuth (Business Profile API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/oauth/google/callback"

# Facebook OAuth (Graph API)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/api/oauth/facebook/callback"

# ===========================================
# CLOUDFLARE TURNSTILE (CAPTCHA)
# ===========================================
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# CORS - Allowed origins for extension and web app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000

# Frontend URLs
FRONTEND_URL=http://localhost:5173
EXTENSION_ID=

# Scraping (optional for dashboard review sync)
OUTSCRAPER_API_KEY=

# LemonSqueezy Variants (configure after creating products in LemonSqueezy)
# Monthly variants
LEMONSQUEEZY_STARTER_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_BUSINESS_MONTHLY_VARIANT_ID=
# Yearly variants
LEMONSQUEEZY_STARTER_YEARLY_VARIANT_ID=
LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=
LEMONSQUEEZY_BUSINESS_YEARLY_VARIANT_ID=

# Rate limiting
API_RATE_LIMIT_PER_MINUTE=60
REPLY_RATE_LIMIT_PER_MINUTE=20

# ===========================================
# TRIGGERFLOW INTEGRATION
# ===========================================
# TriggerFlow API URL for token validation (SSO)
TRIGGERFLOW_API_URL=
# API key for machine-to-machine calls (optional)
TRIGGERFLOW_API_KEY=

# ===========================================
# APIFY SCRAPING (Premium Feature)
# ===========================================
# Apify API token for running actors
APIFY_API_TOKEN=
# Webhook URL for Apify to call on completion (should be public)
APIFY_WEBHOOK_URL="${APP_URL}/api/webhooks/apify"
